# Copie este arquivo para .env e preencha.

# Obrigatório: sua chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Recomendado se o Jarvis ficar na internet: senha para usar o assistente
JARVIS_SENHA=

# Opcional: seu nome, para o Jarvis te chamar por ele
JARVIS_NOME_USUARIO=

# Opcional: fuso horário (padrão America/Sao_Paulo) e porta (padrão 3000)
JARVIS_FUSO=America/Sao_Paulo
PORT=3000

# Opcional: Google Agenda (veja "Ligar o Google Agenda" no README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: avisos no WhatsApp (veja "Avisos no WhatsApp" no README)
WHATSAPP_TELEFONE=
WHATSAPP_APIKEY=
# Hora do resumo diário no WhatsApp (0 a 23, padrão 7). Use "desligado" para não receber.
JARVIS_RESUMO_HORA=7

# Opcional: ligar o Jarvis ao sistema da Porto e Toledo (somente leitura)
# TOLEDO_URL=https://pkslldmrhgaacwnrxboi.supabase.co/functions/v1/jarvis-leitura
# TOLEDO_TOKEN=
# Telegram: token do robô criado no @BotFather (veja o README)
TELEGRAM_BOT_TOKEN=
